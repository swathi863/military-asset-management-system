# CORS Allowed Origins (Comma separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Active Profile
SPRING_PROFILES_ACTIVE=mysql

# Frontend API URL
VITE_API_BASE_URL=https://military-asset-management-system-jx2m.onrender.com/api

