# Database Configuration
DB_URL=jdbc:mysql://localhost:3306/military_asset_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=YOUR_DATABASE_PASSWORD_HERE

# JWT Secret Configuration (Mandatory in production)
